{
  "name": "itqan",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test:learning": "npx --yes tsx scripts/test-learning-policy.ts",
    "test:persistence": "npx --yes tsx scripts/test-persistence.ts",
    "test:session-engine": "npx --yes tsx scripts/test-session-engine-safety.ts",
    "test:worker": "npx --yes tsx scripts/test-voice-worker.ts",
    "preview": "vite preview",
    "cf:check": "npm run build && npx --yes wrangler@4 deploy --dry-run",
    "cf:dev": "npm run build && npx --yes wrangler@4 dev",
    "cf:deploy": "npm run build && npx --yes wrangler@4 deploy"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.11",
    "typescript": "^5.7.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2"
  }
}
